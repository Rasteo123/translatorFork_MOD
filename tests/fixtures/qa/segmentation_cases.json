            "inlines": [
              {"id": "i-duplicate-1", "type": "text", "text": "The bell rang."}
            ]
          },
          {
            "id": "b-duplicate-2",
            "tag": "p",
            "role": "paragraph",
            "inlines": [
              {"id": "i-duplicate-2", "type": "text", "text": "The bell rang."}
            ]
          }
        ]
      },
      "expected": [
